<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/products.css" />

<%
  const list = Array.isArray(products) ? products : [];
  const categoryCount = 6;
  const currentPage = typeof page !== 'undefined' ? page : 1;
  const perPage = typeof limit !== 'undefined' ? limit : list.length;
  const totalItems = typeof total !== 'undefined' ? total : list.length;
  const pageCount = typeof totalPages !== 'undefined' ? totalPages : 1;
  const startIndex = totalItems === 0 ? 0 : (currentPage - 1) * perPage + 1;
  const endIndex = (currentPage - 1) * perPage + list.length;
  const adminName = (typeof member !== 'undefined' && member && member.memberNick) ? member.memberNick : 'Pettynara Store';
%>

<body>
  <div class="pn-shell">
    <!-- ============ TOP NAV ============ -->
    <header class="pn-topnav">
      <a class="pn-brand" href="/admin/">
        <svg class="pn-paw" viewBox="0 0 512 512" aria-hidden="true">
          <ellipse cx="256" cy="340" rx="98" ry="80" />
          <ellipse cx="150" cy="248" rx="44" ry="58" />
          <ellipse cx="224" cy="188" rx="42" ry="58" />
          <ellipse cx="300" cy="188" rx="42" ry="58" />
          <ellipse cx="374" cy="248" rx="44" ry="58" />
        </svg>
        <span>Pettynara <strong>Admin</strong></span>
      </a>

      <nav class="pn-topnav-links">
        <a href="/admin/">Dashboard</a>
        <a class="active" href="/admin/product/all">Pets &amp; Items</a>
        <a href="/admin/user/all">Users</a>
      </nav>

      <div class="pn-topnav-right">
        <button type="button" class="pn-bell" aria-label="Notifications">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" />
            <path d="M13.73 21a2 2 0 0 1-3.46 0" />
          </svg>
          <span class="pn-bell-badge">3</span>
        </button>
        <div class="pn-user">
          <img src="/img/pettynara/paw-logo.svg" alt="Pettynara" />
          <div class="pn-user-meta">
            <span class="pn-user-name"><%= adminName %></span>
            <span class="pn-user-role">Admin</span>
          </div>
        </div>
        <a class="pn-logout" href="/admin/logout" onclick="return confirm('Do you want to logout?')">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
            <polyline points="16 17 21 12 16 7" />
            <line x1="21" y1="12" x2="9" y2="12" />
          </svg>
          Logout
        </a>
      </div>
    </header>

    <div class="pn-body">
      <!-- ============ SIDEBAR ============ -->
      <aside class="pn-sidebar">
        <nav class="pn-side-nav">
          <a class="active" href="/admin/product/all">
            <svg viewBox="0 0 512 512" aria-hidden="true">
              <ellipse cx="256" cy="340" rx="98" ry="80" />
              <ellipse cx="150" cy="248" rx="44" ry="58" />
              <ellipse cx="224" cy="188" rx="42" ry="58" />
              <ellipse cx="300" cy="188" rx="42" ry="58" />
              <ellipse cx="374" cy="248" rx="44" ry="58" />
            </svg>
            Pets &amp; Items
          </a>
          <a href="/admin/">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
              <polyline points="9 22 9 12 15 12 15 22" />
            </svg>
            Dashboard
          </a>
          <a href="/admin/user/all">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
              <circle cx="9" cy="7" r="4" />
              <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
            </svg>
            Users
          </a>
          <a href="#">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3" />
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
            </svg>
            Settings
          </a>
        </nav>

        <div class="pn-promo">
          <img src="/img/pettynara/dogs.jpg" alt="Pets" />
          <strong>Pettynara Admin</strong>
          <p>Manage your pet shop with ease and love</p>
        </div>

        <div class="pn-help">
          <span class="pn-help-title">Need help?</span>
          <span class="pn-help-sub">We are here for you</span>
          <a href="#">Contact Support</a>
        </div>
      </aside>

      <!-- ============ MAIN ============ -->
      <main class="pn-main products-container">
        <div class="pn-main-head">
          <div>
            <h1 class="pn-title">Pets &amp; Items</h1>
            <p class="pn-subtitle">Manage pet listings, supplies, pricing, and visibility.</p>
          </div>
          <button class="pn-add-btn" id="process-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10" />
              <line x1="12" y1="8" x2="12" y2="16" />
              <line x1="8" y1="12" x2="16" y2="12" />
            </svg>
            Add Pet / Item
          </button>
        </div>

        <!-- ===== Stat cards ===== -->
        <section class="pn-stats">
          <div class="pn-stat">
            <div class="pn-stat-icon green">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z" />
                <line x1="7" y1="7" x2="7.01" y2="7" />
              </svg>
            </div>
            <div class="pn-stat-text">
              <span class="pn-stat-label">Active Listings</span>
              <span class="pn-stat-value"><%= activeCount %></span>
              <span class="pn-stat-foot">live in the store</span>
            </div>
          </div>

          <div class="pn-stat">
            <div class="pn-stat-icon amber">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="6" y="4" width="4" height="16" rx="1" />
                <rect x="14" y="4" width="4" height="16" rx="1" />
              </svg>
            </div>
            <div class="pn-stat-text">
              <span class="pn-stat-label">Paused Listings</span>
              <span class="pn-stat-value"><%= pausedCount %></span>
              <span class="pn-stat-foot">currently hidden</span>
            </div>
          </div>

          <div class="pn-stat">
            <div class="pn-stat-icon teal">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7" rx="1.5" />
                <rect x="14" y="3" width="7" height="7" rx="1.5" />
                <rect x="3" y="14" width="7" height="7" rx="1.5" />
                <rect x="14" y="14" width="7" height="7" rx="1.5" />
              </svg>
            </div>
            <div class="pn-stat-text">
              <span class="pn-stat-label">Pet Categories</span>
              <span class="pn-stat-value"><%= categoryCount %></span>
              <span class="pn-stat-foot">Categories</span>
            </div>
          </div>

          <div class="pn-stat">
            <div class="pn-stat-icon violet">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" />
                <circle cx="8.5" cy="8.5" r="1.5" />
                <polyline points="21 15 16 10 5 21" />
              </svg>
            </div>
            <div class="pn-stat-text">
              <span class="pn-stat-label">Image Uploads</span>
              <span class="pn-stat-value"><%= imageCount %></span>
              <span class="pn-stat-foot">Total images</span>
            </div>
          </div>
        </section>

        <!-- ===== Listings table ===== -->
        <section class="pn-card pn-listings">
          <h2 class="pn-card-title">Pettynara Listings</h2>
          <div class="pn-table-wrap">
            <table class="pn-table">
              <thead>
                <tr>
                  <th>No</th>
                  <th>Listing Name</th>
                  <th>Category</th>
                  <th>Price</th>
                  <th>Status</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <!--  LOOP PRODUCTS: START  -->
                <% products.map(function (value, key) { %>
                <%
                  const coll = (value.productCollection || 'OTHER');
                  const collLabel = coll.charAt(0) + coll.slice(1).toLowerCase();
                  const imgs = value.productImages || value.productmages || [];
                  const thumb = imgs.length ? ('/' + String(imgs[0]).replace(/^\.?\//, '')) : '/img/upload.svg';
                  const st = value.productStatus;
                %>
                <tr>
                  <td class="pn-col-no"><%= (currentPage - 1) * perPage + key + 1 %></td>
                  <td>
                    <div class="pn-listing-name">
                      <img class="pn-thumb" src="<%= thumb %>" alt="" onerror="this.src='/img/upload.svg'" />
                      <span><%= value.productName %></span>
                    </div>
                  </td>
                  <td>
                    <span class="pn-badge badge-<%= coll.toLowerCase() %>"><%= collLabel %></span>
                  </td>
                  <td class="pn-price">₩<%= Number(value.productPrice || 0).toLocaleString('en-US') %></td>
                  <td>
                    <select
                      class="spec-select new-product-status status-<%= st %>"
                      id="<%= value._id %>"
                    >
                      <option value="PAUSE" <%= st === 'PAUSE' ? 'selected' : '' %>>PAUSE</option>
                      <option value="PROCESS" <%= st === 'PROCESS' ? 'selected' : '' %>>PROCESS</option>
                      <option value="DELETE" <%= st === 'DELETE' ? 'selected' : '' %>>DELETE</option>
                    </select>
                  </td>
                  <td>
                    <div class="pn-actions">
                      <button type="button" class="pn-icon-btn edit" title="Edit" aria-label="Edit"
                        data-id="<%= value._id %>"
                        data-name="<%= value.productName %>"
                        data-price="<%= value.productPrice %>"
                        data-status="<%= value.productStatus %>">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                          <path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4z" />
                        </svg>
                      </button>
                      <button type="button" class="pn-icon-btn delete" title="Delete" aria-label="Delete"
                        data-id="<%= value._id %>"
                        data-name="<%= value.productName %>">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="3 6 5 6 21 6" />
                          <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                        </svg>
                      </button>
                    </div>
                  </td>
                </tr>
                <% }) %>
                <!--  LOOP PRODUCTS: END  -->
              </tbody>
            </table>
          </div>
          <div class="pn-table-foot">
            <span>Showing <%= startIndex %> to <%= endIndex %> of <%= totalItems %> entries</span>
            <% if (pageCount > 1) { %>
            <div class="pn-pagination">
              <% if (currentPage > 1) { %>
              <a class="pn-page-nav" href="/admin/product/all?page=<%= currentPage - 1 %>" aria-label="Previous">&lsaquo;</a>
              <% } else { %>
              <span class="pn-page-nav disabled" aria-hidden="true">&lsaquo;</span>
              <% } %>
              <% for (let i = 1; i <= pageCount; i++) { %>
              <a class="pn-page-num<%= i === currentPage ? ' active' : '' %>" href="/admin/product/all?page=<%= i %>"><%= i %></a>
              <% } %>
              <% if (currentPage < pageCount) { %>
              <a class="pn-page-nav" href="/admin/product/all?page=<%= currentPage + 1 %>" aria-label="Next">&rsaquo;</a>
              <% } else { %>
              <span class="pn-page-nav disabled" aria-hidden="true">&rsaquo;</span>
              <% } %>
            </div>
            <% } %>
          </div>
        </section>

        <!-- ===== Create form ===== -->
        <form
          onsubmit="return validateForm()"
          action="/admin/product/create"
          method="POST"
          class="dish-container pn-card pn-form"
          enctype="multipart/form-data"
        >
          <h2 class="pn-card-title">Create Pet / Item Listing</h2>

          <input name="productStatus" value="PAUSE" class="product-status" hidden />

          <div class="pn-form-grid">
            <div class="pn-field">
              <label>Pet / Item Name</label>
              <input type="text" placeholder="Enter pet or item name" name="productName" class="product-name" />
            </div>
            <div class="pn-field">
              <label>Price (₩)</label>
              <input type="number" placeholder="0" name="productPrice" class="product-price" />
            </div>
            <div class="pn-field">
              <label>Category</label>
              <select class="product-collection" name="productCollection">
                <option value="DOG" selected>Dog</option>
                <option value="CAT">Cat</option>
                <option value="FISH">Fish</option>
                <option value="BIRD">Bird</option>
                <option value="OTHER">Other</option>
              </select>
            </div>
          </div>

          <div class="pn-field pn-field-full">
            <label>Description</label>
            <textarea name="productDesc" class="product-desc" placeholder="Write details about the pet or item..."></textarea>
          </div>

          <div class="pn-field pn-field-full">
            <label>Upload Images <span class="pn-hint">Add up to 5 photos</span></label>
            <div class="media-frame">
              <div class="upload-img-box">
                <img src="/img/upload.svg" class="1" id="image-section-1" />
                <input type="file" id="file" name="productImages" class="image-one" required onchange="previewFileHandler(this, 1)" />
              </div>
              <div class="upload-img-box">
                <img src="/img/upload.svg" class="2" id="image-section-2" />
                <input type="file" id="file" name="productImages" class="image-two" onchange="previewFileHandler(this, 2)" />
              </div>
              <div class="upload-img-box">
                <img src="/img/upload.svg" class="3" id="image-section-3" />
                <input type="file" id="file" name="productImages" class="image-three" onchange="previewFileHandler(this, 3)" />
              </div>
              <div class="upload-img-box">
                <img src="/img/upload.svg" class="4" id="image-section-4" />
                <input type="file" id="file" name="productImages" class="image-four" onchange="previewFileHandler(this, 4)" />
              </div>
              <div class="upload-img-box">
                <img src="/img/upload.svg" class="5" id="image-section-5" />
                <input type="file" id="file" name="productImages" class="image-five" onchange="previewFileHandler(this, 5)" />
              </div>
              <input name="restaurantIid" class="restaurant-id" hidden />
            </div>
          </div>

          <div class="operation-buttons">
            <button class="pn-btn-ghost" id="cancel-btn">Cancel</button>
            <button type="submit" class="pn-btn-solid" id="create-btn">
              <svg viewBox="0 0 512 512" aria-hidden="true">
                <ellipse cx="256" cy="340" rx="98" ry="80" />
                <ellipse cx="150" cy="248" rx="44" ry="58" />
                <ellipse cx="224" cy="188" rx="42" ry="58" />
                <ellipse cx="300" cy="188" rx="42" ry="58" />
                <ellipse cx="374" cy="248" rx="44" ry="58" />
              </svg>
              Create Listing
            </button>
          </div>
        </form>
      </main>
    </div>
  </div>

  <script type="text/javascript" src="/js/products.js"></script>
</body>

<%- include('includes/footer') %>
