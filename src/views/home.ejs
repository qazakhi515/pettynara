<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/home.css" />

<body>
  <div class="home-container">
    <div class="navigation-menu">
      <ul class="nav justify-content-center">
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link active" href="/admin"><%= member ? 'Dashboard' : 'Home' %></a>
        </li>
        <% if(!member) { %>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/signup">Create account</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/login">Login</a>
        </li>
        <% } else { %>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/product/all">Pets &amp; Items</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/user/all">Users</a>
        </li>
        <li
          class="nav-item"
          style="cursor: pointer"
          onclick="return confirm('Do you want to logout?')"
        >
          <a class="nav-link" href="/admin/logout">Logout</a>
        </li>
        <% } %>
      </ul>
    </div>

    <div class="dashboard">
      <div class="dashboard-hero">
        <p class="dashboard-brand">Pettynara Admin</p>
        <h1>Welcome to Pettynara Admin</h1>
        <p class="dashboard-subtitle">
          Manage pets, pet items, sellers, and customer orders in one place.
        </p>
      </div>

      <div class="stat-grid">
        <div class="stat-card">
          <span class="stat-label">Pets</span>
        </div>
        <div class="stat-card">
          <span class="stat-label">Pet Items</span>
        </div>
        <div class="stat-card">
          <span class="stat-label">Users</span>
        </div>
        <div class="stat-card">
          <span class="stat-label">Orders</span>
        </div>
      </div>

      <div class="category-section">
        <h2 class="section-title">Categories</h2>
        <div class="category-grid">
          <div class="category-card">Dogs</div>
          <div class="category-card">Cats</div>
          <div class="category-card">Birds</div>
          <div class="category-card">Fish</div>
          <div class="category-card">Rabbits</div>
          <div class="category-card">Accessories</div>
        </div>
      </div>

      <div class="quick-actions">
        <a class="quick-action-btn" href="/admin/product/all">Manage Pets &amp; Items</a>
        <a class="quick-action-btn secondary" href="/admin/user/all">View Users</a>
      </div>
    </div>
  </div>
</body>

<%- include('includes/footer') %>
