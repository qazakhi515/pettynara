<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/signup.css" />

<body>
  <div class="signup-container">
    <header class="auth-nav">
      <div class="auth-nav-inner">
        <a class="auth-nav-brand" href="/admin">
          <svg class="auth-nav-paw" viewBox="0 0 512 512" aria-hidden="true">
            <ellipse cx="256" cy="340" rx="98" ry="80" />
            <ellipse cx="150" cy="248" rx="44" ry="58" />
            <ellipse cx="224" cy="188" rx="42" ry="58" />
            <ellipse cx="300" cy="188" rx="42" ry="58" />
            <ellipse cx="374" cy="248" rx="44" ry="58" />
          </svg>
          <span>Pettynara <strong>Admin</strong></span>
        </a>
        <nav class="auth-nav-links">
          <a class="auth-nav-link" href="/admin">Home</a>
          <a class="auth-nav-link active" href="/admin/signup">Create account</a>
          <a class="auth-nav-link auth-nav-cta" href="/admin/login">Login</a>
        </nav>
      </div>
    </header>

    <form onsubmit="return validateSignupForm()"
    action="/admin/signup" method="POST" enctype="multipart/form-data">
      <div class="signup-frame" style="width: 650px">
        <div class="signup-top">
          <p class="brand">Pettynara Admin</p>
          <span>Create Pettynara Seller Account</span>
          <p class="subtitle">Start managing pets and pet items today.</p>
        </div>

        <div class="sign-input-frame" style="justify-content: space-between">
          <div class="sign-up-frame">
            <label>Seller name *</label>
            <input
              type="text"
              name="memberNick"
              class="member-nick"
              placeholder="Username"
              value=""
            />
          </div>
          <div class="sign-up-frame">
            <label>Phone *</label>
            <input
              type="text"
              name="memberPhone"
              class="member-phone"
              placeholder="Phone"
              value=""
            />
          </div>
        </div>
        <div class="sign-input-frame" style="justify-content: space-between">
          <div class="sign-up-frame">
            <label>Password *</label>
            <input
              type="password"
              name="memberPassword"
              class="member-password"
              placeholder="Password"
              value=""
            />
          </div>
          <div class="sign-up-frame">
            <label>Repeat password *</label>
            <input
              type="password"
              name="confirmPassword"
              class="confirm-password"
              placeholder="Repeat password"
              value=""
            />
          </div>
        </div>

        <div class="signup-input-frame">
          <div class="media-frame">
            <img class="upload-img-frame" src="/img/default.jpeg" />
            <div class="upload-container">
              <span class="media-text">Store image</span>
              <div
                class="file-box bs3-primary preview-image"
                style="margin-top: 25px; display: flex"
              >
                <input
                  class="upload-name"
                  value="Choose image"
                  disabled="disabled"
                />
                <label for="input-file" class="file-input-label"
                  >Upload Image</label
                >
                <input
                  type="file"
                  id="input-file"
                  class="upload-hidden form-control-file member-image"
                  name="memberImage"
                />
              </div>
              <p class="thumbnail-desc">
                Please upload your store image.<br />
                Attention only:.jpg, .jpeg, or .png. <br />
                formats allowed!
              </p>
            </div>
          </div>
        </div>

        <input name="memberType" value="ADMIN" hidden />

        <button class="signup-btn btn" name="signup" type="submit">
          Create account
        </button>
      </div>
    </form>
  </div>

  <script type="text/javascript" src="/js/signup.js"></script>
</body>

<%- include('includes/footer') %>
