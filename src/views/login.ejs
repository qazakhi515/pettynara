<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/login.css" />

<body>
  <form class="login-container" action="/admin/login" METHOD="POST">
    <div class="login-frame">
      <div class="login-top">
        <p class="brand">Pettynara Admin</p>
        <span>Seller Login</span>
        <p class="subtitle">
          Manage pets, pet items, and customer orders from one dashboard.
        </p>
        <div>Go back <a href="/admin" style="color: #0f766e">Home</a></div>
        <p>
          Not registered yet?
          <a href="/admin/signup" style="color: #0f766e">Create account</a>
        </p>
      </div>
      <div class="login-input-frame">
        <div class="login-input-container">
          <label>Seller name *</label>
          <input
            type="text"
            name="memberNick"
            class="member-nick"
            placeholder="Username"
            value=""
            required
          />
        </div>
        <div class="login-input-container">
          <label>Password *</label>
          <input
            type="password"
            name="memberPassword"
            class="member-password"
            placeholder="Password"
            value=""
            required
          />
        </div>
      </div>
      <button class="login-btn btn" name="login" type="submit">Login</button>
    </div>
  </form>
</body>

<%- include('includes/footer') %>
