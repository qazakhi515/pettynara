PORT=3003
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>/Pettynara

# Admin panel session and JWT signing
SESSION_SECRET=change-me
SECRET_TOKEN=change-me

# Optional: without these, uploads are stored in ./uploads
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
