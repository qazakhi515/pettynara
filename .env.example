PORT=3003
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>/Pettynara

# Admin panel session and JWT signing
SESSION_SECRET=change-me
SECRET_TOKEN=change-me

# Optional: rate limiting, caching and admin sessions. Without it, rate limits
# and sessions are kept in memory and nothing is cached.
# Local: redis://localhost:6379   Docker Compose: redis://redis:6379
REDIS_URL=

# Toss Payments secret key (결제위젯 연동 키, test_gsk_... for test mode).
# Server only: never put it in the frontend. Without it, payment returns 503.
TOSS_SECRET_KEY=

# Optional: without these, uploads are stored in ./uploads
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
